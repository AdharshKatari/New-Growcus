# Database (Supabase) — Two URLs required
# Pooler: for app queries (PgBouncer transaction mode, serverless-safe)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct: for prisma migrate / db push only
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Auth.js v5
NEXTAUTH_SECRET="replace-with-32-char-random-string"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN="EAAxxxx..."
WHATSAPP_PHONE_NUMBER_ID="1234567890"
WHATSAPP_OTP_TEMPLATE_NAME="growcus_otp"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"

# AI (optional — mocked when absent)
GEMINI_API_KEY=""

# Dev mode — set to true to bypass WhatsApp OTP (use code 1234)
DEV_MODE_OTP=true
DEV_OTP_CODE=1234

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# GROWCUS ENTERPRISE INFRASTRUCTURE CONFIGURATIONS
# -----------------------------------------------------------------------------
# SECURE SYSTEM CRON WORKER SECRET TOKEN
CRON_SECRET_TOKEN="your_high_entropy_alphanumeric_cron_secret_string"

# COMPLIANT A2P ENTERPRISE MESSAGE GATEWAYS (DLT VERIFIED)
EXOTEL_API_KEY="your_exotel_credential_key_here"
EXOTEL_API_TOKEN="your_exotel_secret_token_here"
EXOTEL_ACCOUNT_SID="your_exotel_subaccount_sid"
EXOTEL_DLT_ENTITY_ID="your_government_dlt_registration_entity_id"
EXOTEL_SENDER_ID="GRWCUS"

# SELF-HOSTED OPEN SOURCE RUNTIME CLUSTER NODES (₹0 TRANS COMPUTE)
LOCAL_INFERENCE_SERVER_URL="http://localhost:11434/api/generate"

# COMPLIANT NATIVE DEVICE DEPLOYMENT SCHEDULER
NEXT_PUBLIC_FCM_VAPID_PUBLIC_KEY="your_firebase_cloud_messaging_vapid_key_string"

